#!/usr/bin/env bash

ROOT_DIR=${ROOT_DIR:-$(cd "$(dirname ${BASH_SOURCE[0]})/.." && pwd)} && export ROOT_DIR
. $ROOT_DIR/bin/_shared

usage()
{
  cat << USAGE >&2
Description:
  Build

Usage:
  ${ALIASING_CMD_NAME:-$CMD_NAME}

Alias(es):
  ${ALIASED_CMD_NAME:-b}

Options:
  -b | --bundle                         Bundle PHP files?
  -c | --compiler-too                   Build the compiler first
  -w | --watch                          Watch mode
USAGE
  exit 1
}

main () {
    old_wd=$(pwd)

    dir=$(dirname "$0")/..
    cd "$dir"

    # Fix for broken symlinks in CI/CD before Spago runs
    if [ -L .spago ]; then mkdir -p "$(readlink .spago)"; fi
    if [ -L output ]; then mkdir -p "$(readlink output)"; fi

    if [[ "$COMPILER_TOO" == '1' ]]; then
      echo "Building compiler..."
      (cd "$dir/../phpurs" && npm run build) || exit 1
      rm -rf run/bak/php/output/*
      rm -rf run/bak/php/.spago/*
      echo ""
    fi

    cmd="spago build"

    if [[ "$WATCH" == '1' ]]; then
      cmd="$cmd --watch"
    fi
    
    if [[ "$BUNDLE" == '1' ]]; then
      is_php=0
      if [[ -d "$ROOT_DIR/run/bak/php/vendor" ]]; then
        is_php=1
      fi

      if [[ "$is_php" == '1' ]]; then
        cmd="$cmd --backend-args \"--bundle\" --backend-args \"--autoload-path\" --backend-args \"run/bak/php/vendor/autoload.php\""
      else
        cmd="$cmd --backend-args \"--bundle\""
      fi
    fi
    
    eval $cmd

    if [[ "$WATCH" != '1' ]]; then
      echo "Generating sourcemaps..."
      # Generate sourcemaps after build completes, directly via the compiler (purs)
      purs compile 'output/*/*.purs' --codegen sourcemaps 2>/dev/null
    fi

    echo "Interpolating the config..."
    (child_bin "conf" || true) &>/dev/null

    echo ''
    echo "Done!"

    cd "$old_wd"
}

# process arguments
while [[ $# -gt 0 ]]
do
  case "$1" in
    -b | --bundle)
    BUNDLE=1
    shift
    ;;
    -w | --watch)
    WATCH=1
    shift
    ;;
    -c | --compiler-too)
    COMPILER_TOO=1
    shift
    ;;
    -h | --help)
    usage
    ;;
    *)
    shift
    ;;
  esac
done

BUNDLE=${BUNDLE:-0}
WATCH=${WATCH:-0}
COMPILER_TOO=${COMPILER_TOO:-0}

main